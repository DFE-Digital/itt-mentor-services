<% content_for :page_title, title_with_error_prefix(t(".page_title", contextual_text:), error: current_step.errors.any?) %>

<%= form_for(current_step, url: current_step_path, method: :put) do |f| %>
  <%= f.govuk_error_summary %>

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <span class="govuk-caption-l"><%= contextual_text %></span>

      <% if current_step.claim_windows.none? %>
        <h1 class="govuk-heading-l"><%= t(".title") %></h1>
        <p class="govuk-body"><%= t(".none") %></p>
      <% else %>
        <%= f.govuk_collection_radio_buttons(
          :id,
          current_step.claim_windows,
          :id,
          ->(claim_window) { t(".claim_window_label", academic_year: claim_window.academic_year_name) },
          ->(claim_window) { t(".claim_window_hint", starts_on: l(claim_window.starts_on, format: :long), ends_on: l(claim_window.ends_on, format: :long)) },
          legend: { text: t(".title"), tag: "h1", size: "l" },
          hint: { text: t(".hint") },
        ) %>

        <%= f.govuk_submit t(".continue") %>
      <% end %>
    </div>
  </div>
<% end %>
