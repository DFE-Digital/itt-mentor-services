<% content_for :page_title, title_with_error_prefix(t(".page_title", contextual_text:), error: current_step.errors.any?) %>

<%= form_for(current_step, url: current_step_path, method: :put) do |f| %>
  <%= f.govuk_error_summary %>

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <span class="govuk-caption-l"><%= contextual_text %></span>
      <h1 class="govuk-heading-l"><%= t(".title") %></h1>

      <%= govuk_warning_text(text: t(".warning")) %>

      <p class="govuk-body"><%= t(".only_use_when") %></p>
      <ul class="govuk-list govuk-list--bullet">
        <li><%= t(".outside_claim_window") %></li>
        <li><%= t(".same_rules") %></li>
        <li><%= t(".recorded") %></li>
      </ul>

      <%= f.govuk_check_boxes_fieldset :confirmed, multiple: false, legend: { text: t(".legend"), hidden: true } do %>
        <%= f.govuk_check_box :confirmed, true, false, multiple: false, label: { text: t(".label") }, link_errors: true %>
      <% end %>

      <%= f.govuk_submit t(".continue") %>
    </div>
  </div>
<% end %>
