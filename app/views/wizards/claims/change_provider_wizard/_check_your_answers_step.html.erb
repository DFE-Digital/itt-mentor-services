<% content_for :page_title, title_with_error_prefix(
  t(".page_title", contextual_text:),
  error: current_step.errors.any?,
) %>

<%= form_for(current_step, url: current_step_path, method: :put) do |f| %>
  <%= f.govuk_error_summary %>

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <span class="govuk-caption-l"><%= contextual_text %></span>
      <h1 class="govuk-heading-l"><%= t(".title") %></h1>

      <%= govuk_summary_list do |summary_list| %>
        <% summary_list.with_row do |row| %>
          <% row.with_key(text: t(".current_provider")) %>
          <% row.with_value(text: current_step.claim.provider_name) %>
        <% end %>

        <% summary_list.with_row do |row| %>
          <% row.with_key(text: t(".new_provider")) %>
          <% row.with_value(text: current_step.provider_name) %>
          <% row.with_action(text: t("change"),
                             href: step_path(:provider),
                             visually_hidden_text: t(".new_provider"),
                             html_attributes: {
                               class: "govuk-link--no-visited-state",
                             }) %>
        <% end %>
      <% end %>

      <% if current_step.removed_mentor_trainings.any? || current_step.reduced_mentor_trainings.any? %>
        <h2 class="govuk-heading-m"><%= t(".mentor_changes") %></h2>
        <p class="govuk-body"><%= t(".mentor_changes_description") %></p>

        <%= govuk_summary_list(actions: false) do |summary_list| %>
          <% current_step.removed_mentor_trainings.each do |mentor_training| %>
            <% summary_list.with_row do |row| %>
              <% row.with_key(text: mentor_training.mentor_full_name) %>
              <% row.with_value(text: t(".mentor_removed", provider_name: current_step.provider_name)) %>
            <% end %>
          <% end %>

          <% current_step.reduced_mentor_trainings.each do |mentor_training, hours| %>
            <% summary_list.with_row do |row| %>
              <% row.with_key(text: mentor_training.mentor_full_name) %>
              <% row.with_value(text: t(".hours_reduced", from: mentor_training.hours_completed, to: hours)) %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>

      <% if current_step.requires_audit? %>
        <%= govuk_warning_text(text: t(".audit_warning", provider_name: current_step.provider_name)) %>
      <% end %>

      <%= f.govuk_submit t(".submit") %>
    </div>
  </div>
<% end %>
