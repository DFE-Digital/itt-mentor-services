<%= render "claims/providers/primary_navigation", provider: @provider, current: :users %>

<%= content_for(:before_content) do %>
  <%= govuk_back_link(href: back_link_path) %>
<% end %>

<div class="govuk-width-container">
  <%= render_wizard(@wizard, contextual_text: t(".caption")) %>

  <p class="govuk-body">
    <%= govuk_link_to(t(".cancel"), claims_provider_users_path(@provider), no_visited_state: true) %>
  </p>
</div>
