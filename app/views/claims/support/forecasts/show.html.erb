<% content_for :page_title, t(".heading") %>
<% render "claims/support/primary_navigation", current: :settings %>

<%= content_for(:before_content) do %>
  <%= govuk_back_link(href: claims_support_settings_path) %>
<% end %>

<div class="govuk-width-container">
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-l"><%= t(".heading") %></h1>

      <%= form_with url: claims_support_forecast_path, method: :get do |f| %>
        <%= f.govuk_radio_buttons_fieldset :claim_window_id, legend: { text: t(".claim_window"), size: "s" } do %>
          <% @claim_windows.each do |claim_window| %>
            <%= f.govuk_radio_button :claim_window_id, claim_window.id, label: { text: claim_window.name }, checked: claim_window == @claim_window, link_errors: claim_window == @claim_windows.first %>
          <% end %>
        <% end %>
        <%= f.govuk_submit t(".submit") %>
      <% end %>
    </div>
  </div>

  <% if @forecast %>
    <div class="govuk-grid-row">
      <div class="govuk-grid-column-two-thirds">
        <% @forecast.groups.each do |group| %>
          <h2 class="govuk-heading-m"><%= group.name %></h2>
          <%= govuk_table do |table| %>
            <% table.with_head do |head| %>
              <% head.with_row do |row| %>
                <% row.with_cell text: t(".table.type_of_establishment") %>
                <% row.with_cell text: t(".table.amount"), numeric: true %>
              <% end %>
            <% end %>
            <% table.with_body do |body| %>
              <% group.rows.each do |group_row| %>
                <% body.with_row do |row| %>
                  <% row.with_cell text: group_row.type_of_establishment %>
                  <% row.with_cell text: group_row.total.format, numeric: true %>
                <% end %>
              <% end %>
              <% body.with_row do |row| %>
                <% row.with_cell text: t(".table.group_total"), classes: "govuk-!-font-weight-bold" %>
                <% row.with_cell text: group.total.format, numeric: true, classes: "govuk-!-font-weight-bold" %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>

        <%= govuk_table do |table| %>
          <% table.with_head do |head| %>
            <% head.with_row do |row| %>
              <% row.with_cell text: t(".table.all_groups") %>
              <% row.with_cell text: t(".table.amount"), numeric: true %>
            <% end %>
          <% end %>
          <% table.with_body do |body| %>
            <% body.with_row do |row| %>
              <% row.with_cell text: t(".table.total"), classes: "govuk-!-font-weight-bold" %>
              <% row.with_cell text: @forecast.total.format, numeric: true, classes: "govuk-!-font-weight-bold" %>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
