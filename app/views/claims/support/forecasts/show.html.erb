<% content_for :page_title, t(".heading") %>
<% render "claims/support/primary_navigation", current: :settings %>

<%= content_for(:before_content) do %>
  <%= govuk_back_link(href: claims_support_settings_path) %>
<% end %>

<div class="govuk-width-container">
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-l"><%= t(".heading") %></h1>

      <%= form_with url: claims_support_forecast_path, method: :get do |f| %>
        <%= f.govuk_radio_buttons_fieldset :claim_window_id, legend: { text: t(".claim_window"), size: "s" } do %>
          <% @claim_windows.each do |claim_window| %>
            <%= f.govuk_radio_button :claim_window_id, claim_window.id, label: { text: claim_window.name }, checked: claim_window == @claim_window, link_errors: claim_window == @claim_windows.first %>
          <% end %>
        <% end %>
        <%= f.govuk_submit t(".submit") %>
      <% end %>
    </div>
  </div>

  <% if @forecast %>
    <div class="govuk-grid-row">
      <div class="govuk-grid-column-two-thirds">
        <%= govuk_tabs do |tabs| %>
          <% tabs.with_tab(label: t(".forecast")) do %>
            <%= render "forecast", forecast: @forecast %>
          <% end %>
          <% tabs.with_tab(label: t(".total_claims")) do %>
            <%= render "forecast", forecast: @total_claims %>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
