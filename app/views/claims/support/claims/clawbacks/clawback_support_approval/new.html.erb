<%= render "claims/support/primary_navigation", current: :claims %>
<% content_for(:page_title) { sanitize t(".page_title", reference: @claim.reference) } %>
<% content_for(:before_content) do %>
  <%= govuk_back_link(href: claims_support_claims_clawback_path(@claim)) %>
<% end %>

<div class="govuk-width-container">
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <span class="govuk-caption-l"><%= t(".caption", reference: @claim.reference) %></span>
      <h1 class="govuk-heading-l"><%= t(".title") %></h1>

      <% @mentor_trainings.each do |mentor_training| %>
        <div id="mentor-training-<%= mentor_training.id %>">
          <%= govuk_summary_card(title: mentor_training.mentor_full_name) do |card| %>
            <% card.with_summary_list(actions: false) do |summary_list| %>
              <% summary_list.with_row do |row| %>
                <% row.with_key(text: t(".original")) %>
                <% row.with_value(text: pluralize(mentor_training.hours_completed, t(".hour"))) %>
              <% end %>

              <% summary_list.with_row do |row| %>
                <% row.with_key(text: t(".mentor_worked_hours")) %>
                <% row.with_value(text: pluralize(mentor_training.corrected_hours_completed, t(".hour"))) %>
              <% end %>

              <% summary_list.with_row do |row| %>
                <% row.with_key(text: t(".hours_clawed_back")) %>
                <% row.with_value(text: pluralize(mentor_training.hours_clawed_back, t(".hour"))) %>
              <% end %>

              <% summary_list.with_row do |row| %>
                <% row.with_key(text: t(".rate")) %>
                <% row.with_value(text: humanized_money_with_symbol(mentor_training.region_funding_available_per_hour)) %>
              <% end %>

              <% summary_list.with_row do |row| %>
                <% row.with_key(text: t(".clawback_amount")) %>
                <% row.with_value(text: humanized_money_with_symbol(mentor_training.clawback_amount)) %>
              <% end %>

              <% summary_list.with_row do |row| %>
                <% row.with_key(text: t(".reason_clawed_back")) %>
                <% row.with_value(text: mentor_training.reason_clawed_back) %>
              <% end %>
            <% end %>
          <% end %>
        </div>
      <% end %>

      <div id="clawback_summary">
        <h2 class="govuk-heading-m"><%= t(".summary") %></h2>

        <%= govuk_summary_list(actions: false) do |summary_list| %>
          <% summary_list.with_row do |row| %>
            <% row.with_key(text: t(".original_amount")) %>
            <% row.with_value(text: humanized_money_with_symbol(@claim.amount)) %>
          <% end %>

          <% summary_list.with_row do |row| %>
            <% row.with_key(text: t(".hours_clawed_back")) %>
            <% row.with_value(text: pluralize(@mentor_trainings.sum { |mentor_training| mentor_training.hours_clawed_back.to_i }, t(".hour"))) %>
          <% end %>

          <% summary_list.with_row do |row| %>
            <% row.with_key(text: t(".clawback_amount")) %>
            <% row.with_value(text: humanized_money_with_symbol(@claim.total_clawback_amount)) %>
          <% end %>

          <% summary_list.with_row do |row| %>
            <% row.with_key(text: t(".adjusted_total")) %>
            <% row.with_value(text: humanized_money_with_symbol(@claim.amount_after_clawback)) %>
          <% end %>
        <% end %>
      </div>

      <div class="govuk-button-group">
        <%= govuk_button_to t(".approve"), new_clawback_support_approval_claims_support_claims_clawback_path(@claim), form_class: "app-claim-actions__form" %>
        <%= govuk_link_to t(".cancel"), claims_support_claims_clawback_path(@claim), no_visited_state: true %>
      </div>
    </div>
  </div>
</div>
