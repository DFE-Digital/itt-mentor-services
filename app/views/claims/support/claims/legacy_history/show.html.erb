<%= render "claims/support/primary_navigation", current: :claims %>
<% content_for(:page_title) { t(".page_title", reference: @claim.reference) } %>
<% content_for(:before_content) do %>
  <%= govuk_back_link href: claims_support_claim_path(@claim) %>
<% end %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-full">
    <span class="govuk-caption-l"><%= t(".caption", reference: @claim.reference) %></span>
    <h1 class="govuk-heading-l"><%= t(".heading") %></h1>
    <p class="govuk-body"><%= t(".description") %></p>

    <h2 class="govuk-heading-m"><%= t(".audits") %></h2>
    <% if @audits.any? %>
      <% @audits.each do |audit| %>
        <%= govuk_details(summary_text: t(".audit", id: audit.id, action: audit.action)) do %>
          <pre class="govuk-body govuk-!-font-size-16"><%= audit.attributes.to_json %></pre>
        <% end %>
      <% end %>
      <%= render PaginationComponent.new(pagy: @audits_pagy) %>
    <% else %>
      <p class="govuk-body"><%= t(".no_audits") %></p>
    <% end %>

    <h2 class="govuk-heading-m"><%= t(".activities") %></h2>
    <% if @activities.any? %>
      <% @activities.each do |activity| %>
        <h3 class="govuk-heading-s"><%= activity.title %></h3>
        <p class="govuk-body"><%= govuk_link_to t(".activity_details"), claims_support_claims_claim_activity_path(activity) %></p>
        <%= govuk_details(summary_text: t(".raw_activity")) do %>
          <pre class="govuk-body govuk-!-font-size-16"><%= activity.attributes.to_json %></pre>
          <% if activity.record.present? %>
            <pre class="govuk-body govuk-!-font-size-16"><%= activity.record.attributes.to_json %></pre>
          <% end %>
        <% end %>
      <% end %>
      <%= render PaginationComponent.new(pagy: @activities_pagy) %>
    <% else %>
      <p class="govuk-body"><%= t(".no_activities") %></p>
    <% end %>
  </div>
</div>
